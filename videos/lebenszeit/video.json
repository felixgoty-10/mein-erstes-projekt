{
  "title": "In dieser Stadt steht über jedem, wie lange er noch lebt",
  "voice": {
    "length_scale": 1.0
  },
  "music": {
    "mood": "horror",
    "volume": 0.32
  },
  "sentences": [
    {
      "id": "s1",
      "text": "In dieser Stadt steht über jedem Menschen, wie viele Tage er noch zu leben hat."
    },
    {
      "id": "s2",
      "text": "Luca hat noch dreiundsechzig Jahre."
    },
    {
      "id": "s3",
      "text": "Seine Mutter hat achtundzwanzig Jahre.",
      "pause": 0.2
    },
    {
      "id": "s4",
      "text": "Sein Vater neunzehn."
    },
    {
      "id": "s4b",
      "text": "Niemand weiß, was passiert, wenn die Zahl null erreicht.",
      "pause": 0.3
    },
    {
      "id": "s5",
      "text": "Eines Nachts wacht Luca um drei Uhr auf."
    },
    {
      "id": "s6",
      "text": "Jemand klopft leise an seine Tür."
    },
    {
      "id": "s7",
      "text": "Er schaut durch das Schlüsselloch."
    },
    {
      "id": "s8",
      "text": "Niemand ist da.",
      "pause": 0.25
    },
    {
      "id": "s8b",
      "text": "Nur Stille.",
      "pause": 0.4
    },
    {
      "id": "s9",
      "text": "Als er sich umdreht, steht eine schwarze Gestalt in der Ecke."
    },
    {
      "id": "s10",
      "text": "Über ihrem Kopf steht eine Zahl: Null.",
      "pause": 0.3
    },
    {
      "id": "s10b",
      "text": "Sie bewegt sich nicht. Sie starrt ihn nur an.",
      "pause": 0.3
    },
    {
      "id": "s11",
      "text": "Luca rennt zu seinen Eltern."
    },
    {
      "id": "s12",
      "text": "Doch sie glauben ihm nicht."
    },
    {
      "id": "s12b",
      "text": "Sein Vater sagt nur: Du hast geträumt.",
      "pause": 0.3
    },
    {
      "id": "s13",
      "text": "Am nächsten Morgen in der Schule sieht er die Gestalt wieder."
    },
    {
      "id": "s14",
      "text": "Sie steht direkt hinter seiner besten Freundin Mia."
    },
    {
      "id": "s14b",
      "text": "Mia lacht und merkt nichts."
    },
    {
      "id": "s15",
      "text": "Über Mias Kopf steht nicht mehr achtundzwanzig Jahre.",
      "pause": 0.2
    },
    {
      "id": "s16",
      "text": "Sondern zehn Sekunden."
    },
    {
      "id": "s16b",
      "text": "Neun. Acht. Sieben.",
      "pause": 0.4
    },
    {
      "id": "s17",
      "text": "Luca schreit: Mia!"
    },
    {
      "id": "s18",
      "text": "Doch die Gestalt dreht sich langsam zu ihm um."
    },
    {
      "id": "s19",
      "text": "Und über Lucas Kopf steht plötzlich: Null Sekunden.",
      "pause": 0.4
    },
    {
      "id": "s20",
      "text": "Dann flüstert jemand direkt hinter ihm:",
      "pause": 0.3
    },
    {
      "id": "s21",
      "text": "Du hättest mich letzte Nacht nicht sehen dürfen."
    }
  ],

    "eq": "highpass=f=110,equalizer=f=250:t=q:w=1:g=-2,equalizer=f=3200:t=q:w=1.4:g=3,highshelf=f=7000:g=2,acompressor=threshold=-20dB:ratio=3:attack=4:release=70"

  "sentences": [
    {
      "id": "s1",
      "text": "In dieser Stadt geht niemand mehr arbeiten.",
      "end": true
    },
    {
      "id": "s2",
      "text": "Tag eins: Alle feiern.",
      "end": true
    },
    {
      "id": "s3",
      "text": "Tag drei: Der Bäcker schläft aus."
    },
    {
      "id": "s4",
      "text": "Kein Brot.",
      "end": true
    },
    {
      "id": "s5",
      "text": "Tag fünf: Der Müll stapelt sich bis zum Dach.",
      "end": true
    },
    {
      "id": "s6",
      "text": "Tag sieben: Der Supermarkt ist leer.",
      "end": true
    },
    {
      "id": "s7",
      "text": "Und dann wird Opa krank."
    },
    {
      "id": "s8",
      "text": "Aber der Arzt?"
    },
    {
      "id": "s9",
      "text": "Liegt auf dem Sofa.",
      "end": true
    },
    {
      "id": "s10",
      "text": "Da merke ich: Arbeit ist nicht nur Geld."
    },
    {
      "id": "s11",
      "text": "Arbeit heißt, wir helfen uns gegenseitig.",
      "end": true
    },
    {
      "id": "s12",
      "text": "Also backe ich Brot."
    },
    {
      "id": "s13",
      "text": "Für Opa."
    },
    {
      "id": "s14",
      "text": "Für den Arzt.",
      "end": true
    },
    {
      "id": "s15",
      "text": "Am nächsten Morgen ist die ganze Stadt wieder da.",
      "end": true
    },
    {
      "id": "s16",
      "text": "Nur der Bäcker schläft immer noch.",
      "end": true
    }
  ],
